---
layout: null
permalink: /sitemap.xml
sitemap: false
---
{% comment %}
  Hand-built bilingual sitemap (excluded from localization, so it is
  rendered once). Every indexable page is listed in both languages
  with hreflang alternates. Pages opt out with `sitemap: false`.
{% endcomment %}<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for p in site.pages %}
{%- if p.layout == 'default' and p.sitemap != false %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <xhtml:link rel="alternate" hreflang="es-MX" href="{{ site.url }}{{ p.url }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}/en{{ p.url }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ p.url }}"/>
  </url>
  <url>
    <loc>{{ site.url }}/en{{ p.url }}</loc>
    <xhtml:link rel="alternate" hreflang="es-MX" href="{{ site.url }}{{ p.url }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}/en{{ p.url }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ p.url }}"/>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
